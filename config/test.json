{
  "database": {
    "type": "postgres",
    "host": "localhost",
    "port": 5432,
    "username": "postgres",
    "password": "postgres",
    "database": "genericfoalts_test",
    "dropSchema": true,
    "synchronize": true,
    "pool": {
      "max": 5,
      "min": 1,
      "idleTimeout": 10000,
      "connectionTimeout": 2000
    }
  },
  "jwt": {
    "secret": "test-jwt-secret-not-for-production"
  },
  "smtp": {
    "host": "env(SMTP_HOST)",
    "port": "env(SMTP_PORT)",
    "secure": "env(SMTP_SECURE)",
    "user": "env(SMTP_USER)",
    "password": "env(SMTP_PASSWORD)",
    "fromAddress": "env(SMTP_FROM_ADDRESS)"
  },
  "bcrypt": {
    "saltRounds": 1
  }
}
