{
  "port": "env(PORT)",
  "settings": {
    "session": {
      "store": "@foal/typeorm"
    }
  },
  "database": {
    "type": "sqlite",
    "database": "./db.sqlite3"
  },
  "jwt": {
    "secret": "env(JWT_SECRET)",
    "accessTokenExpiresIn": "15m",
    "refreshTokenExpiresIn": "7d"
  },
  "bcrypt": {
    "saltRounds": 10
  },
  "app": {
    "baseUrl": "env(APP_BASE_URL)",
    "frontendBaseUrl": "env(APP_FRONTEND_BASE_URL)"
  },
  "smtp": {
    "host": "env(SMTP_HOST)",
    "port": "env(SMTP_PORT)",
    "secure": "env(SMTP_SECURE)",
    "user": "env(SMTP_USER)",
    "password": "env(SMTP_PASSWORD)",
    "fromAddress": "env(SMTP_FROM_ADDRESS)"
  },
  "rateLimit": {
    "default": {
      "points": 120,
      "duration": 60
    },
    "auth": {
      "points": 60,
      "duration": 60
    },
    "endpoints": {
      "AuthController.login": {
        "points": 15,
        "duration": 60
      },
      "AuthController.register": {
        "points": 25,
        "duration": 60
      }
    }
  },
  "logger": {
    "requestLogger": {
      "enabled": true,
      "format": "json",
      "skipPaths": ["/health", "/health/live", "/health/ready", "/health/db"]
    }
  },
  "cors": {
    "allowedOrigins": "env(CORS_ALLOWED_ORIGINS)",
    "allowedMethods": "GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS",
    "allowedHeaders": "Content-Type,Authorization,X-CSRF-Token",
    "allowCredentials": true,
    "exposeHeaders": "X-CSRF-Token",
    "maxAge": 86400
  },
  "csrf": {
    "enabled": true,
    "cookieName": "csrf_token",
    "requestHeaderName": "x-csrf-token",
    "responseHeaderName": "X-CSRF-Token",
    "cookiePath": "/",
    "cookieHttpOnly": false,
    "cookieSameSite": "strict",
    "skipForJwtBearer": true,
    "rotateOnLoginMethod": "POST",
    "rotateOnLoginPath": "/api/auth/login",
    "exemptPaths": "/csp-violation-report"
  },
  "security": {
    "helmet": {
      "enabled": true,
      "enforceHttpsInProduction": true,
      "trustProxy": false,
      "referrerPolicy": "no-referrer",
      "csp": {
        "reportUri": "/csp-violation-report"
      }
    }
  },
  "fileUpload": {
    "storagePath": "./storage/uploads",
    "maxSizeBytes": 5242880,
    "allowedMimeTypes": ["image/jpeg", "image/png", "application/pdf"]
  }
}
